(rule
 (targets build_flags.ml)
 (action
  (with-stdout-to %{targets}
   (run /bin/sh -c "if [ \"${C2C_ENABLE_MCP_DEBUG_TOOL:-}\" = 1 ]; then echo 'let mcp_debug_tool_enabled = true'; elif [ \"${C2C_ENABLE_MCP_DEBUG_TOOL:-}\" = 0 ]; then echo 'let mcp_debug_tool_enabled = false'; elif [ \"%{profile}\" = release ]; then echo 'let mcp_debug_tool_enabled = false'; else echo 'let mcp_debug_tool_enabled = true'; fi"))))

; #420: embed git SHA at compile time so c2c --version no longer pays a
; ~1s shell-out to `git rev-parse` on every invocation. Falls back to
; "unknown" when git is unavailable (source-tarball install, sandboxed
; build env, etc.) — Version.git_sha consumers MUST treat that string
; as opaque (don't rely on hex shape). Override at build time by
; exporting C2C_BUILD_GIT_SHA in the build env.
(rule
 ; #420 fix(jungle FAIL): mark this rule as always-rerun so dune
 ; regenerates the SHA on every build invocation. Without this,
 ; dune caches the SHA across checkouts and the binary reports a
 ; stale build identifier — exactly the regression jungle
 ; reproduced. We can't `(deps (file ../.git/HEAD))` because
 ; `.git/HEAD` is outside the dune source tree (dune rejects with
 ; "No rule found"). `(deps (universe))` is the canonical idiom
 ; for "always run". The underlying `git rev-parse` is fast (<10ms)
 ; so the per-build cost is negligible vs. the correctness win.
 (deps (universe))
 (targets version_git_sha.ml)
 (action
  (with-stdout-to %{targets}
   (run /bin/sh -c "sha=\"${C2C_BUILD_GIT_SHA:-}\"; if [ -z \"$sha\" ]; then sha=\"$(git rev-parse --short=8 HEAD 2>/dev/null || echo unknown)\"; fi; echo \"let git_sha = \\\"$sha\\\"\""))))

; Bake the build date into the binary at compile time. Replaces the
; env-var approach (version.ml used to read BUILD_DATE from the process
; env at module load) which kept showing 'dev' in production because
; the Dockerfile's ENV/CMD-shell tricks never reliably reached the
; OCaml runtime. C2C_BUILD_DATE is honoured if set so callers can pin
; a reproducible build date; otherwise we capture the date when the
; dune rule runs (== when the binary was compiled).
(rule
 (deps (universe))
 (targets version_build_date.ml)
 (action
  (with-stdout-to %{targets}
   (run /bin/sh -c "date=\"${C2C_BUILD_DATE:-}\"; if [ -z \"$date\" ]; then date=\"$(date -u +%Y-%m-%d)\"; fi; echo \"let build_date = \\\"$date\\\"\""))))

