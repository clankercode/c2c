; c2c_hook_lib: shared stdin-parsing + inbox-drain logic for Claude hooks.
; Used by both c2c_inbox_hook (PostToolUse) and c2c_stop_hook (Stop).
(library
 (name c2c_hook_lib)
 (wrapped false)
 (modules c2c_hook_lib)
 (libraries c2c_mcp c2c_cold_boot_context_lib unix yojson))

(executable
 (name c2c_inbox_hook)
 (modules c2c_inbox_hook)
 (libraries c2c_hook_lib c2c_mcp c2c_cold_boot_context_lib unix))

; c2c_stop_hook: Stop hook for text-only turn delivery (P1).
; Blocks stop to inject queued messages; exits silently when inbox empty.
(executable
 (name c2c_stop_hook)
 (modules c2c_stop_hook)
 (libraries c2c_hook_lib c2c_mcp unix yojson))

(library
 (name c2c_cold_boot_context_lib)
 (wrapped false)
 (modules c2c_cold_boot_context)
 (libraries c2c_mcp unix yojson))

(executable
 (name c2c_cold_boot_hook)
 (modules c2c_cold_boot_hook)
 (libraries c2c_cold_boot_context_lib))

; #349b: post-compact hook split into library + thin executable so the
; payload-formatting logic can be unit-tested. The library is wrapped:false
; so test code can reference C2c_post_compact_hook directly.
(library
 (name c2c_post_compact_hook_lib)
 (wrapped false)
 (modules c2c_post_compact_hook)
 (libraries c2c_mcp unix yojson))

(executable
 (name c2c_post_compact_hook_bin)
 (modules c2c_post_compact_hook_bin)
 (libraries c2c_mcp c2c_post_compact_hook_lib unix yojson))
