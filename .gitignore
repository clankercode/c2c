.c2c/personal-logs/
.c2c/memory/*
!.c2c/memory/.gitkeep
.c2c/schedules/
.c2c/roles/*.md
# Live tmux-supervise manifest is host-specific; the committed template is
# .c2c/supervise.example.toml.
.c2c/supervise.toml

node_modules/
dist/
__pycache__/
*.out
_build/
.worktrees/

# Jekyll docs-site build artifacts + local bundler config/vendor
docs/_site/
docs/.bundle/
docs/vendor/
.opencode/agents
.claude/
.codex/
.kimi/
.c2c/worktrees/
.c2c/*.md
!.c2c/peers.md
.opencode/agent.bak/
*.db
.artifacts/
.c2c/peer-passes/
.collab/personal-logs/
