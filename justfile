# Regenerate ocaml/cli/role_designer_embedded.ml from the canonical builtin.
# The binary embeds role-designer.md so `c2c agent refine` works in any
# checkout (and gracefully ignores missing/relocated files). Dune refuses to
# traverse dotfile dirs, so we preprocess outside dune.
codegen-role-designer:
    #!/usr/bin/env bash
    set -euo pipefail
    src=.c2c/roles/builtins/role-designer.md
    out=ocaml/cli/role_designer_embedded.ml
    if grep -Fq '|role_designer_src}' "$src"; then
        echo "error: role-designer.md contains the OCaml string delimiter '|role_designer_src}'" >&2
        echo "       pick a different delimiter in this recipe and update the embed." >&2
        exit 1
    fi
    {
        printf '(* AUTO-GENERATED by `just codegen-role-designer` from\n'
        printf '   .c2c/roles/builtins/role-designer.md. Do not edit by hand. *)\n\n'
        printf 'let content = {role_designer_src|'
        cat "$src"
        printf '|role_designer_src}\n'
    } > "$out.tmp"
    mv -f "$out.tmp" "$out"

# Regenerate ocaml/cli/role_templates_embedded.ml from the canonical
# role-class templates under .c2c/roles/builtins/templates/. Mirrors
# codegen-role-designer (#423). Embeds each template body verbatim so
# Path A (cold-start prompt) and Path B (agent new) emit canonical
# bodies with first-5-turns + peer-PASS + heartbeat block intact.
codegen-role-templates:
    #!/usr/bin/env bash
    set -euo pipefail
    src_dir=.c2c/roles/builtins/templates
    out=ocaml/cli/role_templates.ml
    delim=role_template_src
    if [ ! -d "$src_dir" ]; then
        echo "error: $src_dir/ not found" >&2
        exit 1
    fi
    {
        printf '(* AUTO-GENERATED by `just codegen-role-templates` from\n'
        printf '   .c2c/roles/builtins/templates/*.md.tmpl. Do not edit by hand.\n'
        printf '\n'
        printf '   Each entry is (role_class, raw_template_body). Substitution of\n'
        printf '   {alias} and {display_name_hint} is performed by the caller via\n'
        printf '   [Role_templates.render]; this module just embeds the source. *)\n\n'
        printf 'let templates : (string * string) list = [\n'
        for f in "$src_dir"/*.md.tmpl; do
            [ -f "$f" ] || continue
            base=$(basename "$f" .md.tmpl)
            if grep -Fq "|$delim}" "$f"; then
                echo "error: $f contains the OCaml string delimiter '|$delim}'" >&2
                echo "       pick a different delimiter in this recipe and update the embed." >&2
                exit 1
            fi
            printf '  ("%s", {%s|' "$base" "$delim"
            cat "$f"
            printf '|%s});\n' "$delim"
        done
        printf ']\n\n'
        printf 'let lookup role_class =\n'
        printf '  try Some (List.assoc role_class templates) with Not_found -> None\n\n'
        printf 'let render ~role_class ~alias ~display_name_hint =\n'
        printf '  match lookup role_class with\n'
        printf '  | None -> None\n'
        printf '  | Some body ->\n'
        printf '    let alias_re = Str.regexp_string "{alias}" in\n'
        printf '    let hint_re  = Str.regexp_string "{display_name_hint}" in\n'
        printf '    let body = Str.global_replace alias_re alias body in\n'
        printf '    let body = Str.global_replace hint_re  display_name_hint body in\n'
        printf '    Some body\n'
    } > "$out.tmp"
    mv -f "$out.tmp" "$out"

# Build the OCaml CLI binary and MCP server (full project)
# Note: this recipe intentionally builds ALL primary targets (c2c.exe + server + hooks)
# so that any compilation error causes a non-zero exit.
# For server-only fast builds use build-server; for CLI-only use build-cli.
#
# Global slot gate + per-worktree flock + shared Dune cache (B125).
# See scripts/dune-build-locked.sh and
# .collab/findings/2026-07-11T*-b125-parallel-dune-global-gate.md.
# Tunables: C2C_DUNE_GLOBAL_SLOTS (default 1), C2C_DUNE_CACHE, DUNE_WATCHDOG_TIMEOUT.
build: codegen-role-designer codegen-opencode-plugin codegen-claude-skill codegen-alias-words
    scripts/dune-build-locked.sh build ./ocaml/cli/c2c.exe ./ocaml/server/c2c_mcp_server.exe ./ocaml/tools/c2c_inbox_hook.exe ./ocaml/tools/c2c_stop_hook.exe ./ocaml/tools/c2c_cold_boot_hook.exe ./ocaml/tools/c2c_post_compact_hook_bin.exe

